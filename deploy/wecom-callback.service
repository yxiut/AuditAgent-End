[Unit]
Description=WeCom Callback Server (企微接收消息服务器)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/wecom-callback
EnvironmentFile=/opt/wecom-callback/wecom-callback.env
ExecStart=/usr/bin/python3 /opt/wecom-callback/wecom_callback_server.py
Restart=always
RestartSec=3
# 安全加固（可选）
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target